# Media: nunca al repo
projects/*/
!projects/.gitkeep
outputs/*
!outputs/.gitkeep
*.mp4
*.mov
*.wav
# Motor vendored: se fija por commit en skills-lock.json
vendor/hyperframes/
# Entorno
.venv/
__pycache__/
*.egg-info/
node_modules/
.env
# Biblioteca de audio: local (re-descargable desde LICENSES.md)
music/*
!music/LICENSES.md
sfx-library/*
!sfx-library/LICENSES.md
*.ogg
